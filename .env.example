# HedgeDoc instance
HEDGEDOC_URL=https://md.example.com

# Option A: a pre-obtained session cookie (get one via `hedgedoc-mcp-login`)
HEDGEDOC_SESSION_COOKIE=

# Only if your instance uses a session cookie name other than connect.sid
# HEDGEDOC_SESSION_COOKIE_NAME=connect.sid

# Option B: login credentials (used for auto re-login when the cookie expires)
# Recommended to set alongside the cookie above for zero-maintenance auth.
HEDGEDOC_EMAIL=
HEDGEDOC_PASSWORD=
